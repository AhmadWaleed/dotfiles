{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/rocket.txt",
        "color": {
            "1": "#E74C3C",
            "2": "#ECF0F1",
            "3": "#95A5A6",
            "4": "#7F8C8D",
            "5": "#E67E22"
        },
        "padding": {
            "top": 2,
            "right": 3
        }
    },
    "display": {
        "color": {
            "keys": "#E67E22",
            "title": "#E74C3C"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
