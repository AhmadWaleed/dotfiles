# ~/.config/ghostty/config.ghostty
# Reference: `ghostty +show-config --default --docs` or https://ghostty.org/docs/config/reference

# Pin shell explicitly - Ghostty's single-instance process caches $SHELL
# from its own start time rather than re-reading /etc/passwd.
command = zsh

# --- Appearance ---
# Follows the OS light/dark appearance setting.
theme = light:Gruvbox Light,dark:Gruvbox Dark

font-family = mononoki
font-size = 12

cursor-style = bar
cursor-style-blink = true

# Default padding (2px) is very tight; this is the most common community tweak.
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# --- Behavior ---
mouse-hide-while-typing = true
copy-on-select = true

# Quake-style dropdown terminal, toggled globally (works even when Ghostty
# isn't focused). Press Ctrl+Grave (the key above Tab) from anywhere.
keybind = global:ctrl+backquote=toggle_quick_terminal

# shell-integration = detect already picks up zsh correctly, no change needed.

# OS-specific keybindings and options: os.ghostty comes from os/<os>/home/.
# Fedora gets Ctrl+Alt "Cmd" stand-ins (GNOME owns Super); macOS keeps Ghostty's
# native Cmd defaults.
config-file = ?os.ghostty
